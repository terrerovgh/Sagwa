{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "esModuleInterop": true,
    "outDir": "dist", "rootDir": "src", "skipLibCheck": true,
    "declaration": true, "sourceMap": true, "noEmitOnError": true
  },
  "include": ["src/**/*.ts"]
}
