FROM python:3.11-slim@sha256:e88e9763f943ec1834f992a4b51e0f24500486803e8bc534e5767af9ea65f6ce
RUN pip install --no-cache-dir torch==2.8.0 torchaudio==2.8.0 --index-url https://download.pytorch.org/whl/cu128
RUN pip install --no-cache-dir numpy==1.26.0 resampy==0.4.3 librosa==0.10.0 s3tokenizer transformers==4.46.3 diffusers==0.29.0 omegaconf==2.3.0 resemble-perth==1.0.1 silero-vad==5.1.2 conformer==0.3.2 safetensors huggingface-hub faster-whisper==1.2.1 piper-tts==1.8.0
COPY server.py tts_router.py chatterbox_engine.py gpu_lease.py /app/
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/models/chatterbox-code/chatterbox/src HF_HUB_OFFLINE=1
CMD ["python","/app/server.py","--config","/private/voice-sagwa.json"]
